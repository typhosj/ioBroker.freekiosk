{
    "i18n": true,
    "type": "tabs",
    "items": {
        "tabTablets": {
            "type": "panel",
            "label": "Tablets",
            "items": {
                "devices": {
                    "type": "table",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "noDelete": false,
                    "label": "Tablets",
                    "help": "devicesHelp",
                    "items": [
                        { "type": "checkbox", "attr": "enabled", "title": "Enabled", "width": "5%", "default": true },
                        { "type": "text", "attr": "name", "title": "Name", "width": "15%", "default": "" },
                        { "type": "text", "attr": "id", "title": "Object ID", "width": "15%", "default": "", "maxLength": 32, "validator": "data.enabled === false || (/^[A-Za-z0-9_-]{1,32}$/.test((data.id || '').trim()) && (data.id || '').trim() !== 'info' && !(globalData.devices || []).some((d, i) => i !== arrayIndex && d && d.enabled !== false && (d.id || '').trim().toLowerCase() === (data.id || '').trim().toLowerCase()))", "validatorErrorText": "idError", "validatorNoSaveOnError": true },
                        {
                            "type": "select",
                            "attr": "transport",
                            "title": "Transport",
                            "width": "10%",
                            "default": "rest",
                            "options": [
                                { "label": "REST", "value": "rest" },
                                { "label": "MQTT", "value": "mqtt" }
                            ]
                        },
                        { "type": "text", "attr": "host", "title": "Host (REST)", "width": "20%", "default": "", "validator": "data.enabled === false || data.transport !== 'rest' || (h => /^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$/.test(h) || (/^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$/.test(h) && (() => { try { return !!new URL('http://[' + h + ']').host; } catch (e) { return false; } })()))((data.host || '').trim())", "validatorErrorText": "hostError", "validatorNoSaveOnError": true },
                        { "type": "number", "attr": "port", "title": "Port (REST)", "width": "10%", "default": 8080, "min": 1, "max": 65535 },
                        { "type": "text", "attr": "topicId", "title": "Topic ID (MQTT)", "width": "15%", "default": "", "maxLength": 64, "validator": "data.enabled === false || data.transport !== 'mqtt' || (/^[^/+#\\s]{0,64}$/.test((data.topicId || '').trim()) && !(globalData.devices || []).some((d, i) => i !== arrayIndex && d && d.enabled !== false && d.transport === 'mqtt' && ((d.topicId || '').trim() || (d.id || '').trim().toLowerCase()) === ((data.topicId || '').trim() || (data.id || '').trim().toLowerCase())))", "validatorErrorText": "topicIdError", "validatorNoSaveOnError": true }
                    ]
                }
            }
        },
        "tabRest": {
            "type": "panel",
            "label": "REST",
            "items": {
                "restInterval": { "type": "number", "label": "Poll interval (s)", "min": 5, "max": 3600, "default": 30, "xs": 12, "sm": 12, "md": 4, "lg": 4, "xl": 4 },
                "restApiKey": { "type": "password", "label": "API key", "help": "restApiKeyHelp", "xs": 12, "sm": 12, "md": 8, "lg": 8, "xl": 8 }
            }
        },
        "tabMqtt": {
            "type": "panel",
            "label": "MQTT",
            "items": {
                "mqttPort": { "type": "number", "label": "Broker port", "min": 1, "max": 65535, "default": 1886, "xs": 12, "sm": 12, "md": 4, "lg": 4, "xl": 4 },
                "mqttBaseTopic": { "type": "text", "label": "Base topic", "default": "freekiosk", "validator": "!(data.devices || []).some(d => d && d.enabled !== false && d.transport === 'mqtt') || (t => !!t && !/[+#]/.test(t) && !t.startsWith('/') && !t.endsWith('/'))((data.mqttBaseTopic || '').trim())", "validatorErrorText": "baseTopicError", "validatorNoSaveOnError": true, "xs": 12, "sm": 12, "md": 8, "lg": 8, "xl": 8 },
                "mqttUser": { "type": "text", "label": "User", "validator": "!(data.devices || []).some(d => d && d.enabled !== false && d.transport === 'mqtt') || !!(data.mqttUser || '').trim()", "validatorErrorText": "loginError", "validatorNoSaveOnError": true, "xs": 12, "sm": 12, "md": 4, "lg": 4, "xl": 4 },
                "mqttPassword": { "type": "password", "label": "Password", "validator": "!(data.devices || []).some(d => d && d.enabled !== false && d.transport === 'mqtt') || !!data.mqttPassword", "validatorErrorText": "loginError", "validatorNoSaveOnError": true, "xs": 12, "sm": 12, "md": 8, "lg": 8, "xl": 8 },
                "mqttHint": { "type": "staticText", "text": "mqttHint", "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12 }
            }
        }
    }
}
